Options -MultiViews
FileETag None
<IfModule mod_headers.c>
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
</IfModule>
<IfModule mod_expires.c>
ExpiresActive Off
</IfModule>
DirectoryIndex index.html
RewriteEngine On

# Capture the URL mount point; never expose Windows filesystem paths in redirects.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=SITE_BASE:%1]

# Discovery URLs follow the current host and installation directory.
RewriteRule ^sitemap\.xml$ site-discovery.php [END]
RewriteRule ^robots\.txt$ site-discovery.php?type=robots [END]

# Current product filenames -> concise canonical product slugs.
RewriteRule ^shop/medicine/alprax-alprazolam-2-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-alprax-2mg [R=301,L,NE]
RewriteRule ^shop/medicine/alprazolam-alprax-1-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-alprax-1mg [R=301,L,NE]
RewriteRule ^shop/medicine/bromazepam-version-4(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/bromazepam [R=301,L,NE]
RewriteRule ^shop/medicine/diazepam-martin-dow-10mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/diazepam-martin-dow-10mg [R=301,L,NE]
RewriteRule ^shop/medicine/easium-diazepam-10mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/diazepam-easium-10mg [R=301,L,NE]
RewriteRule ^shop/medicine/lorazepam-ativan-2-mg-s(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/lorazepam-ativan-2mg [R=301,L,NE]
RewriteRule ^shop/medicine/midolam-midazolam-7-5-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/midazolam-midolam-7-5mg [R=301,L,NE]
RewriteRule ^shop/medicine/modafinil-version-4(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/modafinil [R=301,L,NE]
RewriteRule ^shop/medicine/noctin-nitrazepam-5-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/nitrazepam-noctin-5mg [R=301,L,NE]
RewriteRule ^shop/medicine/pase-clonazepam-2mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/clonazepam-pase-2mg [R=301,L,NE]
RewriteRule ^shop/medicine/pregabalin-pregacare-nt-s(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/pregabalin-pregacare-nt [R=301,L,NE]
RewriteRule ^shop/medicine/rivotril-clonazepam-2mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/clonazepam-rivotril-2mg [R=301,L,NE]
RewriteRule ^shop/medicine/rlam-alprazolam-1-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-rlam-1mg [R=301,L,NE]
RewriteRule ^shop/medicine/sedil-diazepam-5-mg-scm(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/diazepam-sedil-5mg [R=301,L,NE]
RewriteRule ^shop/medicine/zopiclone-7-5mg-version-4(?:\.html)?$ %{ENV:SITE_BASE}shop/medicine/zopiclone-7-5mg [R=301,L,NE]

# Product URLs from the previous sitemap -> new /shop/medicine/ structure.
RewriteRule ^shop/diazepam-sedil-5mg/?$ %{ENV:SITE_BASE}shop/medicine/diazepam-sedil-5mg [R=301,L,NE]
RewriteRule ^shop/diazepam-martin-dows-10mg/?$ %{ENV:SITE_BASE}shop/medicine/diazepam-martin-dow-10mg [R=301,L,NE]
RewriteRule ^shop/diazepam-easium-10mg/?$ %{ENV:SITE_BASE}shop/medicine/diazepam-easium-10mg [R=301,L,NE]
RewriteRule ^shop/alprazolam-alprax-2-mg/?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-alprax-2mg [R=301,L,NE]
RewriteRule ^shop/alprazolam-rlam-1mg/?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-rlam-1mg [R=301,L,NE]
RewriteRule ^shop/alprazolam-alprax-1-mg/?$ %{ENV:SITE_BASE}shop/medicine/alprazolam-alprax-1mg [R=301,L,NE]
RewriteRule ^shop/nitrazepam-noctin-5mg/?$ %{ENV:SITE_BASE}shop/medicine/nitrazepam-noctin-5mg [R=301,L,NE]
RewriteRule ^shop/midazolam-midolam-75-mg/?$ %{ENV:SITE_BASE}shop/medicine/midazolam-midolam-7-5mg [R=301,L,NE]
RewriteRule ^shop/clonazepam-rivotril-2-mg/?$ %{ENV:SITE_BASE}shop/medicine/clonazepam-rivotril-2mg [R=301,L,NE]
RewriteRule ^shop/pregacare-nt-pregabalin/?$ %{ENV:SITE_BASE}shop/medicine/pregabalin-pregacare-nt [R=301,L,NE]
RewriteRule ^shop/ativan-lorazepam-2-mg/?$ %{ENV:SITE_BASE}shop/medicine/lorazepam-ativan-2mg [R=301,L,NE]
RewriteRule ^shop/zopiclone-7-5mg/?$ %{ENV:SITE_BASE}shop/medicine/zopiclone-7-5mg [R=301,L,NE]
RewriteRule ^shop/modafinil/?$ %{ENV:SITE_BASE}shop/medicine/modafinil [R=301,L,NE]
RewriteRule ^shop/bromazepam/?$ %{ENV:SITE_BASE}shop/medicine/bromazepam [R=301,L,NE]

# Additional former product and location links.
RewriteRule ^shop/temazepam/?$ %{ENV:SITE_BASE}shop/medicine/temazepam [R=301,L,NE]
RewriteRule ^shop/(?:nervasin-pregabalin|pregabalin-neurabalin-75mg)/?$ %{ENV:SITE_BASE}shop/category/nerve-pain-and-anxiety-related-medicines [R=301,L,NE]
RewriteRule ^best-online-drugstore-in-scotland/?$ %{ENV:SITE_BASE}service-area/best-online-drugstore-in-scotland-scotiameds-uk [R=301,L,NE]

# Legacy article, landing and location routes.
RewriteRule ^blog/a-safe-way-to-buy-prescription-medicines-online-in-the-uk/?$ %{ENV:SITE_BASE}blog/post/a-safe-way-to-buy-prescription-medicines-online-in-the-uk-scm [R=301,L,NE]
RewriteRule ^blog/a-clear-guide-to-anxiety-and-sleep-medication-for-uk-patients/?$ %{ENV:SITE_BASE}blog/post/a-clear-guide-to-anxiety-and-sleep-medication-for-uk-patients [R=301,L,NE]
RewriteRule ^blog/safe-reliable-pharmacy-service-scotland/?$ %{ENV:SITE_BASE}blog/post/safe-and-reliable-pharmacy-scotia-meds [R=301,L,NE]
RewriteRule ^blog/how-long-can-you-take-sleeping-pills-safely/?$ %{ENV:SITE_BASE}blog/post/how-long-can-you-take-sleeping-pills-safely [R=301,L,NE]
RewriteRule ^blog/signs-of-adhd-in-adults/?$ %{ENV:SITE_BASE}blog/post/10-signs-of-adhd-in-adults [R=301,L,NE]
RewriteRule ^blog/panic-disorder-symptoms-causes-and-treatment/?$ %{ENV:SITE_BASE}blog/post/panic-disorder-symptoms-causes-treatment [R=301,L,NE]
RewriteRule ^blog/neuropathy-or-nerve-pain-causes-symptoms-and-treatment/?$ %{ENV:SITE_BASE}blog/post/neuropathy-or-nerve-pain-causes-symptoms-treatment [R=301,L,NE]
RewriteRule ^blog/buy-medicine-without-prescription-uk/?$ %{ENV:SITE_BASE}blog/post/how-to-buy-medicine-without-prescription-online-in-the-uk [R=301,L,NE]
RewriteRule ^blog/nhs-gphc-law-for-online-pharmacies-uk/?$ %{ENV:SITE_BASE}blog/post/nhs-gphc-law-for-online-pharmacies-in-the-united-kingdom-scotiameds [R=301,L,NE]
RewriteRule ^anxiety-medicines-in-the-united-kingdom/?$ %{ENV:SITE_BASE}landing-page/anxiety-medicines-in-the-united-kingdom-scotiameds [R=301,L,NE]
RewriteRule ^sleeping-pills-in-the-united-kingdom/?$ %{ENV:SITE_BASE}landing-page/sleeping-pills-in-the-united-kingdom-scotiameds [R=301,L,NE]
RewriteRule ^service-area/best-online-drugstore-in-scotland/?$ %{ENV:SITE_BASE}service-area/best-online-drugstore-in-scotland-scotiameds-uk [R=301,L,NE]
RewriteRule ^service-area/trusted-online-drugstore-in-bo-ness/?$ %{ENV:SITE_BASE}service-area/best-online-drugstore-in-boness [R=301,L,NE]
RewriteRule ^service-area/reliable-online-pharmacy-in-perth/?$ %{ENV:SITE_BASE}service-area/best-online-drugstore-in-perth [R=301,L,NE]
RewriteRule ^service-area/reliable-online-pharmacy-in-dunfermline/?$ %{ENV:SITE_BASE}service-area/reliable-online-drugstore-in-dunfermline [R=301,L,NE]
RewriteRule ^service-area/trusted-online-medication-store-in-inverness/?$ %{ENV:SITE_BASE}service-area/trusted-online-drugstore-in-inverness [R=301,L,NE]

# Legacy category slugs with ampersands -> portable SEO-friendly slugs.
RewriteRule ^shop/category/adhd-&-wakefulness(?:\.html)?$ %{ENV:SITE_BASE}shop/category/adhd-and-wakefulness [R=301,L,NE]
RewriteRule ^shop/category/sleep-&-insomnia-medication(?:\.html)?$ %{ENV:SITE_BASE}shop/category/sleep-and-insomnia-medication [R=301,L,NE]
RewriteRule ^shop/category/nerve-pain-&-anxiety-related-medicines(?:\.html)?$ %{ENV:SITE_BASE}shop/category/nerve-pain-and-anxiety-related-medicines [R=301,L,NE]

# Canonicalise explicit index and .html requests.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ %{ENV:SITE_BASE}$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ %{ENV:SITE_BASE}$1 [R=301,L,NE]

# Internally serve extensionless URLs from their HTML files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]
